// Prisma schema for Secure Healthcare Data Sharing Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AccessAction {
  VIEW
  DOWNLOAD
  UPLOAD
  UPDATE
  DELETE
  LOGIN
  GRANT_CONSENT
  REVOKE_CONSENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  attributes   Json     @default("{}")  // department, specialization, etc.
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  records          MedicalRecord[] @relation("PatientRecords")
  givenConsents    Consent[]       @relation("PatientConsents")
  receivedConsents Consent[]       @relation("DoctorConsents")
  accessLogs       AccessLog[]
  otpTokens        OtpToken[]

  @@map("users")
}

model MedicalRecord {
  id             String   @id @default(uuid())
  patientId      String
  title          String
  description    String?
  encryptedData  String   @db.Text  // AES-256-GCM encrypted content
  encryptionIV   String             // Initialization vector
  encryptionTag  String             // Auth tag for GCM
  encryptedKey   String             // Envelope-encrypted DEK
  fileType           String?            // e.g., "application/pdf", "image/png"
  filePath           String?            // Path to encrypted file on disk
  fileEncryptionIV   String?            // IV for file encryption (separate from text)
  fileEncryptionTag  String?            // Auth tag for file encryption
  fileEncryptedKey   String?            // Envelope-encrypted DEK for file
  abePolicy      Json     @default("{}") // Required attributes for access
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  patient    User        @relation("PatientRecords", fields: [patientId], references: [id], onDelete: Cascade)
  consents   Consent[]
  accessLogs AccessLog[]

  @@map("medical_records")
}

model Consent {
  id        String        @id @default(uuid())
  patientId String
  doctorId  String
  recordId  String?       // null = access to ALL patient records
  status    ConsentStatus @default(ACTIVE)
  expiresAt DateTime?
  createdAt DateTime      @default(now())
  revokedAt DateTime?

  // Relations
  patient User           @relation("PatientConsents", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User           @relation("DoctorConsents", fields: [doctorId], references: [id], onDelete: Cascade)
  record  MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@map("consents")
}

model AccessLog {
  id             String       @id @default(uuid())
  userId         String
  recordId       String?
  action         AccessAction
  ipAddress      String?
  userAgent      String?
  details        String?
  blockchainHash String?
  timestamp      DateTime     @default(now())

  // Relations
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  record MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@map("access_logs")
}

model OtpToken {
  id        String   @id @default(uuid())
  userId    String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_tokens")
}

model BlockchainBlock {
  index        Int      @id @default(autoincrement())
  previousHash String
  hash         String
  data         Json
  timestamp    BigInt
  nonce        Int      @default(0)

  @@map("blockchain_blocks")
}
