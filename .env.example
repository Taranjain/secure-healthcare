# ═══════════════════════════════════════════════════════════
# Secure Healthcare Data Sharing Platform - Environment Config
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── PostgreSQL Database ───────────────────────────────────
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare_secret_2024
POSTGRES_DB=healthcare_db

# If running PostgreSQL locally (not via Docker), use:
#   DATABASE_URL=postgresql://healthcare:healthcare_secret_2024@localhost:5432/healthcare_db
# If running via Docker Compose:
DATABASE_URL=postgresql://healthcare:healthcare_secret_2024@postgres:5432/healthcare_db

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── JWT Secrets (CHANGE IN PRODUCTION!) ───────────────────
# Generate secure secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_jwt_super_secret_key_2024
JWT_REFRESH_SECRET=change_me_refresh_secret_key_2024

# ─── AES-256 Master Encryption Key (CHANGE IN PRODUCTION!) ─
# Must be exactly 64 hex characters (32 bytes)
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=change_me_for_master_key

# ─── MFA ───────────────────────────────────────────────────
MFA_ISSUER=HealthcarePlatform

# ─── Frontend ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
